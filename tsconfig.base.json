{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "baseUrl": ".",
    "paths": {
      "@competencias-platform/ui": ["packages/ui/src/index.ts"],
      "@competencias-platform/contracts": ["packages/contracts/src/index.ts"],
      "@competencias-platform/validation": ["packages/validation/src/index.ts"],
      "@competencias-platform/config": ["packages/config/src/index.ts"],
      "@web/*": ["apps/web/src/*"]
    }
  }
}
